# Copy to .env next to compose.yaml and edit.

# The folder steward-ai manages (absolute path on the host).
LIBRARY_1=/path/to/your/files

# Where steward-ai keeps its databases, caches and backups.
STEWARD_DATA=./data

# Port on the host for the web UI.
STEWARD_PORT=8420

# User and group the containers run as; should own LIBRARY_1 and STEWARD_DATA.
PUID=1000
PGID=1000

# Image tag.
STEWARD_VERSION=dev
